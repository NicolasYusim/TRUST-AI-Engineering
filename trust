#!/usr/bin/env python3
"""Dependency-free CLI for T.R.U.S.T. declarations and evidence."""

from __future__ import annotations

from pathlib import Path

from trustlib.cli import main

from trustlib.framework import (
    ROOT,
    coverage_markdown,
    docs_errors,
    lint_manifest,
    manifest_paths,
    registry_errors,
    run_lint,
    run_verify,
    verify_manifest,
)
from trustlib.schema import (
    dotted_get,
    load_json_yaml as _load_json_yaml,
    repository_file,
    sha256_file,
    validate_schema,
)


def load_json_yaml(path: Path):
    """Compatibility wrapper used by repository tests and examples."""

    return _load_json_yaml(path, ROOT)


if __name__ == "__main__":
    raise SystemExit(main())
